# todo.py

TASK_FILE = "tasks.txt"

# Load tasks from file
def load_tasks():
    tasks = []
    try:
        with open(TASK_FILE, "r") as f:
            for line in f:
                tasks.append(line.strip())
    except FileNotFoundError:
        pass
    return tasks

# Save tasks to file
def save_tasks(tasks):
    with open(TASK_FILE, "w") as f:
        for t in tasks:
            f.write(t + "\n")

# View all tasks
def view_tasks(tasks):
    if not tasks:
        print("\nNo tasks found!\n")
        return
    print("\nYour Tasks:")
    for i, t in enumerate(tasks, start=1):
        print(f"{i}. {t}")
    print()

# Add multiple tasks
def add_task(tasks):
    print("Enter tasks (type 'done' to stop):")
    while True:
        task = input("Task: ")
        if task.lower() == "done":
            break
        tasks.append(task)

    save_tasks(tasks)
    print("Tasks added!\n")

# Remove a task
def remove_task(tasks):
    view_tasks(tasks)
    if not tasks:
        return
    try:
        num = int(input("Enter task number to remove: "))
        tasks.pop(num - 1)
        save_tasks(tasks)
        print("Task removed!\n")
    except:
        print("Invalid number!\n")

# MAIN PROGRAM
def main():
    tasks = load_tasks()

    # SIMPLE PREDEFINED TASKS (only added if file is empty)
    if not tasks:
        tasks = ["Drink water", "Finish homework", "Read a book"]
        save_tasks(tasks)

    while True:
        print("==== TO-DO LIST ====")
        print("1. View Tasks")
        print("2. Add Task(s)")
        print("3. Remove Task")
        print("4. Exit")

        choice = input("Choose (1-4): ")

        if choice == "1":
            view_tasks(tasks)
        elif choice == "2":
            add_task(tasks)
        elif choice == "3":
            remove_task(tasks)
        elif choice == "4":
            print("Goodbye!")
            break
        else:
            print("Invalid choice!\n")

if __name__ == "__main__":
    main()
